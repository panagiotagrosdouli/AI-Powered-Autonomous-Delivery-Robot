<sdf version="1.9"><world name="delivery_world">
<physics name="physics" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
<light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><direction>-0.5 0 -1</direction></light>
<model name="ground"><static>true</static><link name="ground"><collision name="c"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision><visual name="v"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></visual></link></model>
<model name="building"><static>true</static><pose>4 3 1.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>3 3 3</size></box></geometry></collision><visual name="v"><geometry><box><size>3 3 3</size></box></geometry></visual></link></model>
<model name="planter"><static>true</static><pose>-2 2 0.3 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>2 0.5 0.6</size></box></geometry></collision><visual name="v"><geometry><box><size>2 0.5 0.6</size></box></geometry></visual></link></model>
<model name="barrier"><static>true</static><pose>1 -3 0.3 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>4 0.3 0.6</size></box></geometry></collision><visual name="v"><geometry><box><size>4 0.3 0.6</size></box></geometry></visual></link></model>
</world></sdf>